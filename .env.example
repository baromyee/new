# Clerk (https://dashboard.clerk.com)
# Google 소셜 로그인만 켜고, 이메일/비밀번호는 끕니다.
# Vercel에도 같은 키를 Production / Preview 환경 변수로 넣어야 합니다.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon PostgreSQL (https://neon.tech)
# DATABASE_URL은 반드시 Pooled connection (-pooler 가 호스트에 들어 있음) 을 넣습니다.
# Vercel Settings → Environment Variables → Production / Preview 모두에 넣으세요.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# 로컬에서 prisma db push 할 때만 필요합니다. Direct connection (-pooler 없음)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
